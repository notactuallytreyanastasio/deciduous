#!/bin/sh
# Wrapper script for deciduex release binary.
# Passes CLI args to Deciduex.CLI.main/1 via release eval.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RELEASE_BIN="$SCRIPT_DIR/../_build/prod/rel/deciduex/bin/deciduex"

if [ ! -f "$RELEASE_BIN" ]; then
  echo "Release not built. Run: cd $(dirname "$SCRIPT_DIR") && MIX_ENV=prod mix release deciduex" >&2
  exit 1
fi

# Convert shell args to an Elixir list of strings
ARGS=""
for arg in "$@"; do
  escaped=$(printf '%s' "$arg" | sed "s/\"/\\\\\"/g")
  if [ -z "$ARGS" ]; then
    ARGS="\"$escaped\""
  else
    ARGS="$ARGS, \"$escaped\""
  fi
done

exec "$RELEASE_BIN" eval "Deciduex.CLI.main([$ARGS])"
