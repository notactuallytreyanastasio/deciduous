# scripts/setup.sh creates .env with real, randomly generated secrets.
# This file documents the settings; do not copy placeholder credentials.
COMPOSE_PROJECT_NAME=deciduous
DECIDUOUS_DATABASE_MODE=local
DECIDUOUS_BIND_ADDRESS=127.0.0.1
# Setup picks a free port in 20000-32767 unless DECIDUOUS_PORT is already set.
# There is no default port: a fixed one squats a port the machine may want.
DECIDUOUS_PORT=24871
DECIDUOUS_MCP_TOKEN=
POSTGRES_PASSWORD=
DATABASE_URL=
DB_SSL=false
DB_SSL_VERIFY=full
DB_SSL_CA_FILE=
POOL_SIZE=10

# Existing PostgreSQL: pass DATABASE_URL and --external-database on first setup.
# Preserve DECIDUOUS_MCP_TOKEN from the old server to keep clients connected.
# Connect as the database owner; migrations also change database-level settings.
# DATABASE_URL=ecto://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE
# DB_SSL=true
# DB_SSL_CA_FILE=/app/certs/postgres-ca.pem
