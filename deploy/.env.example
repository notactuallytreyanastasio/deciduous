# Copy to deploy/.env, fill in, then: chmod 600 deploy/.env
# deploy/.env is gitignored (see .dockerignore + repo .gitignore).

# The bearer token the daemon requires on every request. Every party_line
# instance must send this exact value as `Authorization: Bearer <token>`.
# Generate a fresh one:  openssl rand -hex 32
DECIDUOUS_API_TOKEN=replace-me-with-openssl-rand-hex-32
